# 複製成 .env 後填入（.env 不要放進版本控制）

# Supabase 專案：Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 只放在伺服器，絕對不能放進前端

# 允許呼叫的前端網址（逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 公開部署時設為 1，關閉不用登入即可呼叫的 /plans、/solve。
# 此時前端必須使用 Supabase 模式，改走需登入的 /plans/db。
SOLVER_DISABLE_SNAPSHOT_API=0

# 僅限開啟快照端點的本機環境；勿把這個金鑰放在 VITE_ 前端變數
SOLVER_API_KEY=

# 唯讀雲端 AI：僅後端使用，金鑰不得放進 VITE_ 或 Git。
# Z.ai 一般 API 使用 https://api.z.ai/api/paas/v4；不可用僅限程式開發的 Coding Plan 額度。
AI_SCHEDULE_DATA_APPROVED=false
SCHEDULE_CHAT_PROVIDER=zai
SCHEDULE_CHAT_MODEL=glm-4.6
ZAI_API_KEY=
