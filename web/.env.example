# 複製成 .env.local 後填入；沒填 Supabase 就是「本機模式」（資料存在瀏覽器）
# 公開部署時這些 VITE_ 值會寫入網頁，絕對不要填 service_role key 或其他私密金鑰。

# 排程服務（OR-Tools）的網址
VITE_SOLVER_URL=http://localhost:8080
# 僅供本機開發使用；公開部署不要設定（瀏覽器內的金鑰沒有保密能力）。
VITE_SOLVER_API_KEY=

# Supabase：Connect → Framework（填 publishable key；這兩個值可放在前端）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
